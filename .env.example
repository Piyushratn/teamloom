# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Database URLs
DATABASE_ADMIN_URL=postgresql://teamloom_admin:teamloom_admin_local_pw@localhost:5432/teamloom_dev
DATABASE_URL=postgresql://teamloom_app:teamloom_app_local_pw@localhost:5432/teamloom_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT & Session Security
JWT_ACCESS_SECRET=dev_only_jwt_access_secret_must_be_32_chars_long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# SMTP (Mailpit locally, Resend in production)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@teamloom.local

# LLM Gateway (Google Gemini API Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_DEFAULT_MODEL=gemini-2.5-flash
LLM_EMBEDDING_MODEL=text-embedding-004