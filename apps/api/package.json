{
  "name": "@teamloom/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @teamloom/contracts build && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.15",
    "@teamloom/contracts": "workspace:*",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.38.2",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.1.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@teamloom/eslint-config": "workspace:*",
    "@teamloom/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}